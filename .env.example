# Copy this file to .env and replace placeholders with your environment credentials.
# Do NOT commit credentials or secrets to version control.

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=your_app_secret_key_here
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
FRONTEND_API_BASE_URL=http://127.0.0.1:8000

# TigerGraph Savanna Database Configuration
TG_HOST=https://your-instance.tgcloud.io
TG_RESTPP_PORT=443
TG_GS_PORT=443
TG_SSL_PORT=443
TG_GRAPH_NAME=HHGOA_FRAUD
TG_GRAPHNAME=HHGOA_FRAUD
TG_USERNAME=your_username
TG_PASSWORD=your_password
TG_SECRET=your_tigergraph_secret_here
TG_API_TOKEN=your_tigergraph_api_token_here

# LLM / Intelligence Provider Configuration
LLM_PROVIDER=google
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-flash

# Supporting Services
DATABASE_URL=sqlite:///./fraud_investigation.db
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./data
