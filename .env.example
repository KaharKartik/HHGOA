# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual settings.
# Do NOT commit actual secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-secure-random-secret-key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# TigerGraph Database Configuration
# ------------------------------------------------------------------------------
TG_HOST=http://localhost
TG_RESTPP_PORT=9000
TG_GS_PORT=14240
TG_GRAPH_NAME=FraudGraph
TG_USERNAME=tigergraph
TG_PASSWORD=your_tigergraph_password
TG_SECRET=your_tigergraph_secret
TG_API_TOKEN=your_tigergraph_api_token

# ------------------------------------------------------------------------------
# AI / Agent Configuration (LLM Providers)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AGENT_LLM_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# Detection Pipeline & Storage
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/hhgoa_fraud
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./data
MODEL_ARTIFACTS_DIR=./detection/models
