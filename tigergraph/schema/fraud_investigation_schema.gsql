CREATE VERTEX Customer (PRIMARY_ID customer_id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Card (PRIMARY_ID card_id STRING, customer_id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Transaction (PRIMARY_ID transaction_id STRING, customer_id STRING, ts DATETIME, amount DOUBLE, channel STRING, product_cd STRING, billing_region STRING, purchaser_email STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX DeviceProfile (PRIMARY_ID device_profile_id STRING, device_info STRING, os STRING, browser STRING, screen STRING, device_type STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX EmailDomain (PRIMARY_ID email_domain STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX BillingRegion (PRIMARY_ID billing_region STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX ClosedCase (PRIMARY_ID case_id STRING, customer_id STRING, card_id STRING, outcome STRING, pattern STRING, exposure_usd DOUBLE, actions_taken STRING, report_filed STRING, analyst_notes STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX InvestigationCase (PRIMARY_ID case_id STRING, status STRING, verdict STRING, fraud_probability DOUBLE, pattern STRING, exposure_usd DOUBLE) WITH primary_id_as_attribute="true"

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card)
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction)
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile)
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain)
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion)
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction, delta_seconds INT)
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, InvestigationCase, TO Transaction)
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, InvestigationCase, TO Card)
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, InvestigationCase, TO Card)
CREATE DIRECTED EDGE RELATED_DEVICE (FROM InvestigationCase, TO DeviceProfile)
CREATE DIRECTED EDGE SIMILAR_TO (FROM InvestigationCase, TO ClosedCase)

CREATE GRAPH FraudInvestigationGraph (*)
